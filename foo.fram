
data Eff E = 
  { get : Unit ->[E] Int 
  , put : Int  ->[E] Unit
  }

data BT E = 
  { flip : Unit ->[E] Bool
  , fail : {type X} -> Unit ->[E] X
  }

let hBTFirst = 
  handler BT 
    { flip = effect () =>
      match resume True with
        | Some x => Some x
        | None   => resume False
      end
    , fail = effect () => None
    }
    return x => Some x
    end
    

let hEff (st0 : Int)=
  handler
    Eff
      { get = effect ()      => resume ~st
      , put = effect new_st  => resume {~st=new_st} ()
      }
    parameter ~st = st0
    return x => x
  end

# let _ = handle st with hEff 1 in 
#     st.put 2; printStrLn (st.get ()).toString

let _ =  
         handle bt with hBTFirst in
         handle st with hEff 1 in 
          (if bt.flip () then st.put 5 else ());
          printStrLn (st.get()).toString

